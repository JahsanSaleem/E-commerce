# Container demo uses an isolated MySQL volume, not your local ECOM server.
DB_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
INITIAL_ADMIN_EMAIL=admin@mustafa.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Optional Google sign-in. Fill real credentials only in your ignored .env file.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
GOOGLE_FRONTEND_URL=http://localhost:8080

# Registration OTP email. Real values belong only in the ignored .env file.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=
SMTP_KEY=
MAIL_FROM=

# Optional production HTTPS overlay. Domain DNS must point to your server.
STORE_DOMAIN=
TLS_EMAIL=
DELIVERY_FEE=249.00
